@implements IDisposable
@inherits LayoutComponentBase
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ConnectedCompanyContext ConnectedCompanyContext
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Surface" Dense="true" Class="sample-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Primary"
                       Edge="Edge.Start"
                       Class="drawer-toggle"
                       OnClick="ToggleDrawer" />

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.Code" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2">FreeAgent.NET</MudText>
                <MudText Typo="Typo.caption" Class="shell-subtitle">Developer workbench for OAuth and API surface testing</MudText>
            </MudStack>
        </MudStack>

        <MudSpacer />

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="appbar-actions">
            <MudChip T="string"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Color="Color.Default">
                @FreeAgentWebUrls.GetEnvironmentLabel(ActiveEnvironment)
            </MudChip>

            @if (TokenStore.IsConnected && !string.IsNullOrWhiteSpace(ConnectedCompanyContext.AccountUrl))
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Href="@ConnectedCompanyContext.AccountUrl"
                           Target="_blank"
                           StartIcon="@Icons.Material.Filled.OpenInNew">
                    Open @(ConnectedCompanyContext.CompanyName ?? "account")
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Href="@FreeAgentWebUrls.GetLoginUrl(ActiveEnvironment)"
                           Target="_blank"
                           StartIcon="@Icons.Material.Filled.Login">
                    @FreeAgentWebUrls.GetEnvironmentLabel(ActiveEnvironment) login
                </MudButton>
            }

            <MudChip T="string"
                     Color="@(TokenStore.IsConnected ? Color.Success : Color.Default)"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Icon="@(TokenStore.IsConnected ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)">
                @(TokenStore.IsConnected ? "Connected" : "Awaiting auth")
            </MudChip>
        </MudStack>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" Class="sample-drawer">
        <MudStack Class="drawer-header" Spacing="1">
            <MudText Typo="Typo.overline" Class="drawer-label">Workspace</MudText>
            <MudText Typo="Typo.h6">SDK Explorer</MudText>
            <MudText Typo="Typo.body2" Class="drawer-copy">Use the sample to validate OAuth flow and probe implemented FreeAgent endpoints.</MudText>
        </MudStack>

        <MudDivider Class="mb-2" />

        <MudNavMenu Rounded="true">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Overview
            </MudNavLink>

            <MudNavGroup Title="Company" Icon="@Icons.Material.Filled.Business" Expanded="@IsCompanyRoute">
                <MudNavLink Href="/company" Icon="@Icons.Material.Filled.FactCheck">
                    Company Overview
                </MudNavLink>
                <MudNavLink Href="/company/business-categories" Icon="@Icons.Material.Filled.Category">
                    Business Categories
                </MudNavLink>
                <MudNavLink Href="/company/tax-timeline" Icon="@Icons.Material.Filled.Event">
                    Tax Timeline
                </MudNavLink>
                <MudNavLink Href="/email-addresses" Icon="@Icons.Material.Filled.Email">
                    Email addresses
                </MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Contacts" Icon="@Icons.Material.Filled.Contacts" Expanded="@IsContactsRoute">
                <MudNavLink Href="/contacts" Icon="@Icons.Material.Filled.AllInclusive">
                    Contacts list
                </MudNavLink>
                <MudNavLink Href="/contacts/detail" Icon="@Icons.Material.Filled.Person">
                    Contact CRUD
                </MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Categories" Icon="@Icons.Material.Filled.AccountTree" Expanded="@IsCategoriesRoute">
                <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.AllInclusive">
                    Categories list
                </MudNavLink>
                <MudNavLink Href="/categories/detail" Icon="@Icons.Material.Filled.Edit">
                    Category CRUD
                </MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Developer Tools" Icon="@Icons.Material.Filled.Handyman" Expanded="@IsDeveloperToolsRoute">
                <MudNavLink Href="/sandbox/rate-limit-test" Icon="@Icons.Material.Filled.Speed">
                    Sandbox Rate-Limit Test
                </MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="sample-main">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _wasConnected;
    private bool _companyRefreshFailed;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        _wasConnected = TokenStore.IsConnected;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncConnectedCompanyAsync();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private async Task SyncConnectedCompanyAsync()
    {
        var isConnected = TokenStore.IsConnected;
        if (isConnected == _wasConnected && (!isConnected || ConnectedCompanyContext.IsLoaded || _companyRefreshFailed))
        {
            return;
        }

        _wasConnected = isConnected;

        if (isConnected)
        {
            var refreshed = await ConnectedCompanyContext.RefreshAsync();
            _companyRefreshFailed = !refreshed;
        }
        else
        {
            ConnectedCompanyContext.Clear();
            _companyRefreshFailed = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private string CurrentPath
    {
        get
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var pathWithoutQuery = relativePath.Split('?', '#')[0];
            return pathWithoutQuery.Trim('/');
        }
    }

    private bool IsCompanyRoute =>
        CurrentPath.Equals("company", StringComparison.OrdinalIgnoreCase)
        || CurrentPath.StartsWith("company/", StringComparison.OrdinalIgnoreCase)
        || CurrentPath.Equals("email-addresses", StringComparison.OrdinalIgnoreCase);

    private bool IsContactsRoute =>
        CurrentPath.Equals("contacts", StringComparison.OrdinalIgnoreCase)
        || CurrentPath.StartsWith("contacts/", StringComparison.OrdinalIgnoreCase);

    private bool IsCategoriesRoute =>
        CurrentPath.Equals("categories", StringComparison.OrdinalIgnoreCase)
        || CurrentPath.StartsWith("categories/", StringComparison.OrdinalIgnoreCase);

    private bool IsDeveloperToolsRoute =>
        CurrentPath.StartsWith("sandbox/", StringComparison.OrdinalIgnoreCase);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await SyncConnectedCompanyAsync();
            StateHasChanged();
        });
    }

    private FreeAgentEnvironment ActiveEnvironment =>
        TokenStore.IsConnected ? TokenStore.ConnectedEnvironment : OAuthService.SelectedEnvironment;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0f766e",
            Secondary = "#b45309",
            Tertiary = "#1d4ed8",
            Background = "#f5f7f4",
            Surface = "#fbfcfa",
            AppbarBackground = "rgba(251, 252, 250, 0.92)",
            DrawerBackground = "#f1f5f1",
            DrawerText = "#16211d",
            TextPrimary = "#16211d",
            TextSecondary = "#50615b",
            LinesDefault = "rgba(15, 23, 42, 0.08)"
        },
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft = "280px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Roboto", "Segoe UI", "sans-serif"]
            }
        }
    };
}
