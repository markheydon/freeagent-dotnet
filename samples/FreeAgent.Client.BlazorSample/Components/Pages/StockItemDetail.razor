@page "/stock-items/detail"
@using FreeAgent.Client.Models.StockItems
@using FreeAgent.Client.BlazorSample.Services
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Stock item detail - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Stock items endpoint"
                         Title="Get a single stock item"
                         CallUnderTest="StockItemsService.GetStockItemAsync"
                         Description="Read-only detail probe for a single stock item with wire-to-model diagnostics."
                         EndpointPath="/v2/stock_items/:id"
                         DocsUrl="https://dev.freeagent.com/docs/stock_items" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Connect to FreeAgent from the <MudLink Href="/">overview</MudLink> first.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="contact-crud-progress" />
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Pick a stock item ID from the <MudLink Href="/stock-items">stock items list</MudLink>, or pass <code>?id=12345</code> in the URL.
                    </MudText>
                    <MudNumericField @bind-Value="_stockItemId" @bind-Value:after="OnStockItemIdChanged" Label="Stock item ID" Min="1" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading || _stockItemId is null or < 1"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               OnClick="GetStockItemAsync">Get stock item</MudButton>
                </MudStack>

                @if (_probe is not null && _stockItem is not null)
                {
                    <ModelProbeResults Snapshot="_probe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All StockItem model fields">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Result summary</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">ID: @_stockItem.ResourceId</MudChip>
                            </MudStack>
                        </SummaryContent>
                        <HighlightContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">Description</MudText>
                                        <MudText Typo="Typo.subtitle1">@ValueOrFallback(_stockItem.Description)</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">Stock on hand</MudText>
                                        <MudText Typo="Typo.subtitle1">@(_stockItem.StockOnHand?.ToString() ?? "Not returned")</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">Cost of sale category</MudText>
                                        <MudText Typo="Typo.subtitle1">@ValueOrFallback(_stockItem.CostOfSaleCategoryNominalCode)</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </HighlightContent>
                    </ModelProbeResults>
                }
                else if (!_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Run <strong>Get stock item</strong> to load diagnostics.</MudText>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public long? StockItemIdFromQuery { get; set; }

    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private long? _stockItemId;
    private StockItem? _stockItem;
    private ModelProbeSnapshot? _probe;

    protected override void OnParametersSet()
    {
        if (StockItemIdFromQuery is > 0)
        {
            _stockItemId = StockItemIdFromQuery;
        }
    }

    private void OnStockItemIdChanged()
    {
        _stockItem = null;
        _probe = null;
        _error = null;
    }

    private async Task GetStockItemAsync()
    {
        if (_stockItemId is null or < 1)
        {
            return;
        }

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;
        _stockItem = null;
        _probe = null;

        var diagnosticsEndpoint = $"stock_items/{_stockItemId}";

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _stockItem = await client.StockItems.GetStockItemAsync(_stockItemId.Value);

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);

            _probe = ModelWireDiagnostics.Build(_stockItem, _wireApiResponse, envelopeProperty: "stock_item");
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "Not returned" : value;
}
