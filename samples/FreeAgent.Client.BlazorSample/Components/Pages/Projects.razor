@page "/projects"
@using FreeAgent.Client.Models.Projects
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Projects — FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Projects endpoint"
                         Title="Projects list"
                         CallUnderTest="ProjectService.ListAsync(...)"
                         Description="Load projects, inspect wire-to-model mapping for any row, then jump into Project CRUD to test get, update, and delete."
                         EndpointPath="/v2/projects?page={page}&per_page={perPage}&view={view}"
                         DocsUrl="https://dev.freeagent.com/docs/projects" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Load page 1, then use <strong>Inspect mapping</strong> on any row to see wire-to-model diagnostics.
                        Use <strong>Open in CRUD</strong> to test single-project operations.
                    </MudText>

                    <MudGrid Spacing="2" Class="contacts-filter-grid">
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudSelect T="string"
                                       @bind-Value="_view"
                                       Label="View"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       FullWidth="true">
                                <MudSelectItem Value="@ProjectViews.Active">active</MudSelectItem>
                                <MudSelectItem Value="@ProjectViews.Completed">completed</MudSelectItem>
                                <MudSelectItem Value="@ProjectViews.Cancelled">cancelled</MudSelectItem>
                                <MudSelectItem Value="@ProjectViews.Hidden">hidden</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudSelect T="string"
                                       @bind-Value="_sort"
                                       Label="Sort"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       FullWidth="true">
                                <MudSelectItem Value="@ProjectSortOptions.Name">name</MudSelectItem>
                                <MudSelectItem Value="@ProjectSortOptions.ContactName">contact_name</MudSelectItem>
                                <MudSelectItem Value="@ProjectSortOptions.ContactDisplayName">contact_display_name</MudSelectItem>
                                <MudSelectItem Value="@ProjectSortOptions.CreatedAt">created_at</MudSelectItem>
                                <MudSelectItem Value="@DescUpdatedAtSort">-updated_at</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudNumericField @bind-Value="_contactIdFilter"
                                             Label="Contact ID filter"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3" lg="2">
                            <MudNumericField @bind-Value="_perPage"
                                             Label="Per page"
                                             Min="1"
                                             Max="100"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3" lg="2">
                            <MudSwitch @bind-Value="_nested" Color="Color.Primary" Label="nested=true" />
                        </MudItem>
                        <MudItem xs="12" sm="12" md="4" lg="3" Class="contacts-load-button-item">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudDownload"
                                       Disabled="_loading"
                                       Class="contacts-load-button"
                                       OnClick="LoadProjectsAsync">
                                @if (_loading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Loading…</span>
                                }
                                else
                                {
                                    <span>Load page 1</span>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudStack>

                @if (_pageResult is null && !_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Press <strong>Load page 1</strong> to fetch projects from FreeAgent.</MudText>
                }

                @if (_pageResult is not null)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                            @_pageResult.Items.Count project@(_pageResult.Items.Count == 1 ? string.Empty : "s") on page @_pageResult.Page
                        </MudChip>
                        @if (!string.IsNullOrWhiteSpace(_view))
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">View: @_view</MudChip>
                        }
                        @if (_pageResult.Total > 0)
                        {
                            <MudChip T="string" Variant="Variant.Outlined">Total: @_pageResult.Total</MudChip>
                        }
                    </MudStack>

                    @if (_pageResult.Items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No projects returned for the current filters. Try clearing the view filter, or create a test project from
                            <MudLink Href="/projects/detail">Project CRUD</MudLink>.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_projectRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Name</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Contact</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Name">@ValueOrDash(context.Name)</MudTd>
                                    <MudTd DataLabel="Status">@context.Status</MudTd>
                                    <MudTd DataLabel="Contact">@ValueOrDash(context.ContactName)</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => InspectProjectAsync(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetCrudHref(context.Id)">
                                                Open in CRUD
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedProject is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All Project model fields (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected project</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    ID: @_inspectedProject.ResourceId
                                </MudChip>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
                                    Row @(_inspectedIndex + 1) on page @_pageResult?.Page
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                        <HighlightContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">Name</MudText>
                                        <MudText Typo="Typo.subtitle1">@ValueOrDash(_inspectedProject.Name)</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">Contact</MudText>
                                        <MudText Typo="Typo.subtitle1">@ValueOrDash(_inspectedProject.Contact?.OrganisationName ?? _inspectedProject.ContactName)</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </HighlightContent>
                    </ModelProbeResults>
                }

                <MudExpansionPanels>
                    <MudExpansionPanel Text="Developer probe: auto-pagination (ListAutoPagingAsync)">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2" Class="hero-copy">
                                Optional check that the async enumerator walks every page.
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.AllInclusive"
                                       Disabled="_loadingAll"
                                       OnClick="LoadAllAsync">
                                @if (_loadingAll)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Enumerating…</span>
                                }
                                else
                                {
                                    <span>Count all projects</span>
                                }
                            </MudButton>

                            @if (_allProjectsCount is not null)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                                    <code>ListAutoPagingAsync</code> yielded @_allProjectsCount.Value project@(_allProjectsCount.Value == 1 ? string.Empty : "s").
                                </MudAlert>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private const string DescUpdatedAtSort = "-updated_at";

    private bool _loading;
    private bool _loadingAll;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private PaginatedResponse<Project>? _pageResult;
    private Project? _inspectedProject;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;
    private int? _allProjectsCount;
    private string? _view = ProjectViews.Active;
    private string? _sort;
    private long? _contactIdFilter;
    private bool _nested;
    private int _perPage = 25;

    private IReadOnlyList<ProjectRow> _projectRows => _pageResult?.Items
        .Select(static (project, index) => new ProjectRow(
            index,
            project.ResourceId,
            project.Name,
            project.Status?.ToString() ?? "—",
            project.ContactName))
        .ToList() ?? [];

    private async Task LoadProjectsAsync()
    {
        _pageResult = null;
        _inspectedProject = null;
        _inspectedProbe = null;
        _inspectedIndex = null;
        _allProjectsCount = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;

        var diagnosticsEndpoint = BuildDiagnosticsEndpoint();

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _pageResult = await client.Projects.ListAsync(
                page: 1,
                perPage: _perPage,
                view: _view,
                sort: _sort,
                contactId: _contactIdFilter,
                nested: _nested ? true : null);

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectProjectAsync(int index)
    {
        if (_pageResult is null || index < 0 || index >= _pageResult.Items.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedProject = _pageResult.Items[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "projects", index, out var wireProject))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedProject, wireProject);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedProject, _wireApiResponse, envelopeProperty: "projects");
    }

    private async Task LoadAllAsync()
    {
        _allProjectsCount = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loadingAll = true;
        _error = null;

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            var count = 0;
            await foreach (var _ in client.Projects.ListAutoPagingAsync(
                               perPage: _perPage,
                               view: _view,
                               sort: _sort,
                               contactId: _contactIdFilter,
                               nested: _nested ? true : null))
            {
                count++;
            }

            _allProjectsCount = count;
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                BuildDiagnosticsEndpoint());
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loadingAll = false;
        }
    }

    private string BuildDiagnosticsEndpoint()
    {
        var query = new List<string>
        {
            "page=1",
            $"per_page={_perPage}"
        };

        if (!string.IsNullOrWhiteSpace(_view))
        {
            query.Add($"view={_view}");
        }

        if (!string.IsNullOrWhiteSpace(_sort))
        {
            query.Add($"sort={Uri.EscapeDataString(_sort)}");
        }

        if (_contactIdFilter is > 0)
        {
            query.Add($"contact={Uri.EscapeDataString($"https://api.freeagent.com/v2/contacts/{_contactIdFilter}")}");
        }

        if (_nested)
        {
            query.Add("nested=true");
        }

        return $"projects?{string.Join('&', query)}";
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string GetCrudHref(long id) => $"/projects/detail?id={id}";

    private sealed record ProjectRow(int Index, long Id, string? Name, string Status, string? ContactName);
}
