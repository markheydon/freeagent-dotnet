@page "/stock-items"
@using FreeAgent.Client.Models.StockItems
@using FreeAgent.Client.BlazorSample.Services
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Stock items - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Stock items endpoint"
                         Title="Stock items list"
                         CallUnderTest="StockItemsService.ListAsync(...)"
                         Description="Load stock catalogue items, inspect wire-to-model mapping for any row, then jump into stock item detail for a single GET."
                         EndpointPath="/v2/stock_items?sort={sort}"
                         DocsUrl="https://dev.freeagent.com/docs/stock_items" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Stock items are read-only in the FreeAgent API. Load the catalogue, inspect mapping per row, then open detail for <code>GET /v2/stock_items/:id</code>.
                    </MudText>

                    <MudGrid Spacing="2" Class="contacts-filter-grid">
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudSelect T="string"
                                       @bind-Value="_sort"
                                       Label="Sort"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       FullWidth="true">
                                <MudSelectItem Value="@StockItemSortOptions.CreatedAt">created_at</MudSelectItem>
                                <MudSelectItem Value="@StockItemSortOptions.Description">description</MudSelectItem>
                                <MudSelectItem Value="@StockItemSortOptions.UpdatedAt">updated_at</MudSelectItem>
                                <MudSelectItem Value="@($"-{StockItemSortOptions.CreatedAt}")">-created_at</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="12" md="4" lg="3" Class="contacts-load-button-item">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudDownload"
                                       Disabled="_loading"
                                       OnClick="LoadStockItemsAsync">
                                @if (_loading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Loading…</span>
                                }
                                else
                                {
                                    <span>Load stock items</span>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudStack>

                @if (_stockItems is null && !_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Press <strong>Load stock items</strong> to fetch the catalogue from FreeAgent.</MudText>
                }

                @if (_stockItems is not null)
                {
                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                        @_stockItems.Count stock item@(_stockItems.Count == 1 ? "" : "s") loaded
                    </MudChip>

                    @if (_stockItems.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No stock items returned. Stock is configured in the FreeAgent UI, not via the API.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Description</MudTh>
                                    <MudTh>On hand</MudTh>
                                    <MudTh>Category</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Description">@ValueOrDash(context.Description)</MudTd>
                                    <MudTd DataLabel="On hand">@context.StockOnHand</MudTd>
                                    <MudTd DataLabel="Category">@ValueOrDash(context.CategoryNominalCode)</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => InspectRowAsync(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetDetailHref(context.Id)">
                                                Open detail
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedItem is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All StockItem model fields (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected stock item</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    ID: @_inspectedItem.ResourceId
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                    </ModelProbeResults>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private IReadOnlyList<StockItem>? _stockItems;
    private StockItem? _inspectedItem;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;
    private string _sort = StockItemSortOptions.CreatedAt;

    private IReadOnlyList<StockItemRow> _rows => _stockItems?
        .Select(static (item, index) => new StockItemRow(
            index,
            item.ResourceId,
            item.Description,
            item.StockOnHand?.ToString() ?? "-",
            item.CostOfSaleCategoryNominalCode))
        .ToList() ?? [];

    private async Task LoadStockItemsAsync()
    {
        _stockItems = null;
        _inspectedItem = null;
        _inspectedProbe = null;
        _inspectedIndex = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;

        var diagnosticsEndpoint = $"stock_items?sort={Uri.EscapeDataString(_sort)}";

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _stockItems = await client.StockItems.ListAsync(sort: _sort);

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectRowAsync(int index)
    {
        if (_stockItems is null || index < 0 || index >= _stockItems.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedItem = _stockItems[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "stock_items", index, out var wireItem))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, wireItem);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, _wireApiResponse, envelopeProperty: "stock_items");
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetDetailHref(long id) => $"/stock-items/detail?id={id}";

    private sealed record StockItemRow(int Index, long Id, string? Description, string StockOnHand, string? CategoryNominalCode);
}
