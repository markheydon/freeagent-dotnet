@page "/notes"
@using FreeAgent.Client.Models.Notes
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Notes - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Notes endpoint"
                         Title="Notes list"
                         CallUnderTest="NoteService.ListContactNotesAsync(...) / ListProjectNotesAsync(...)"
                         Description="Load notes for a contact or project parent, inspect wire-to-model mapping for any row, then jump into Note CRUD to test get, create, update, and delete."
                         EndpointPath="/v2/notes?contact={uri} | /v2/notes?project={uri}"
                         DocsUrl="https://dev.freeagent.com/docs/notes" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Notes require a parent contact or project. Choose a parent type and ID, then load the collection.
                        Use <strong>Inspect mapping</strong> on any row, or open <MudLink Href="/notes/detail">Note CRUD</MudLink> for single-note operations.
                    </MudText>

                    <MudGrid Spacing="2" Class="contacts-filter-grid">
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudSelect T="string"
                                       @bind-Value="_parentType"
                                       Label="Parent type"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       FullWidth="true">
                                <MudSelectItem Value="@ParentTypeContact">Contact</MudSelectItem>
                                <MudSelectItem Value="@ParentTypeProject">Project</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudNumericField @bind-Value="_parentId"
                                             Label="Parent ID"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="12" md="4" lg="3" Class="contacts-load-button-item">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudDownload"
                                       Disabled="_loading"
                                       Class="contacts-load-button"
                                       OnClick="LoadNotesAsync">
                                @if (_loading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Loading…</span>
                                }
                                else
                                {
                                    <span>Load notes</span>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudStack>

                @if (_notes is null && !_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Press <strong>Load notes</strong> to fetch notes from FreeAgent.</MudText>
                }

                @if (_notes is not null)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                            @_notes.Count note@(_notes.Count == 1 ? string.Empty : "s")
                        </MudChip>
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
                            Parent: @_parentType @_parentId
                        </MudChip>
                    </MudStack>

                    @if (_notes.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No notes returned for this parent. Create a probe note from
                            <MudLink Href="/notes/detail">Note CRUD</MudLink>.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_noteRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Content</MudTh>
                                    <MudTh>Author</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Content">@ValueOrDash(context.Content)</MudTd>
                                    <MudTd DataLabel="Author">@ValueOrDash(context.Author)</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => InspectNoteAsync(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetCrudHref(context.Id)">
                                                Open in CRUD
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedNote is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All Note model fields (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected note</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    ID: @_inspectedNote.ResourceId
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                    </ModelProbeResults>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private const string ParentTypeContact = "contact";
    private const string ParentTypeProject = "project";

    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private string _parentType = ParentTypeContact;
    private long? _parentId;
    private IReadOnlyList<Note>? _notes;
    private int? _inspectedIndex;
    private Note? _inspectedNote;
    private ModelProbeSnapshot? _inspectedProbe;
    private IReadOnlyList<NoteRow> _noteRows = [];

    private async System.Threading.Tasks.Task LoadNotesAsync()
    {
        if (_parentId is null or < 1)
        {
            _error = "Enter a parent ID.";
            return;
        }

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _inspectedIndex = null;
        _inspectedNote = null;
        _inspectedProbe = null;
        _wireApiResponse = string.Empty;

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _notes = _parentType == ParentTypeContact
                ? await client.Notes.ListContactNotesAsync(contactId: _parentId.Value)
                : await client.Notes.ListProjectNotesAsync(projectId: _parentId.Value);

            _noteRows = _notes
                .Select((note, index) => new NoteRow(index, note.ResourceId, note.Content, note.Author))
                .ToList();

            var queryKey = _parentType == ParentTypeContact ? "contact" : "project";
            var parentUri = _parentType == ParentTypeContact
                ? client.Urls.Contact(_parentId.Value).Uri
                : client.Urls.Project(_parentId.Value).Uri;
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                $"notes?{queryKey}={Uri.EscapeDataString(parentUri)}");
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _notes = null;
            _noteRows = [];
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
            _notes = null;
            _noteRows = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectNoteAsync(int index)
    {
        if (_notes is null || index < 0 || index >= _notes.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedNote = _notes[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "notes", index, out var wireNote))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedNote, wireNote);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedNote, _wireApiResponse, envelopeProperty: "notes");
    }

    private static string GetCrudHref(long id) => $"/notes/detail?id={id}";

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private sealed record NoteRow(int Index, long Id, string? Content, string? Author);
}
