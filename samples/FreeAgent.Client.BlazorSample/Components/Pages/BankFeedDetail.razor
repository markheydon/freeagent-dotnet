@page "/bank-feeds/detail"
@using FreeAgent.Client.Models.BankFeeds
@using FreeAgent.Client.BlazorSample.Services
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Bank feed detail - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Bank feeds endpoint"
                         Title="Get a single bank feed"
                         CallUnderTest="BankFeedsService.GetBankFeedAsync"
                         Description="Read-only detail probe for a single bank feed with wire-to-model diagnostics."
                         EndpointPath="/v2/bank_feeds/:id"
                         DocsUrl="https://dev.freeagent.com/docs/bank_feeds" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Connect to FreeAgent from the <MudLink Href="/">overview</MudLink> first.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="contact-crud-progress" />
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Pick a bank feed ID from the <MudLink Href="/bank-feeds">bank feeds list</MudLink>, or pass <code>?id=12345</code> in the URL.
                    </MudText>
                    <MudNumericField @bind-Value="_bankFeedId" @bind-Value:after="OnBankFeedIdChanged" Label="Bank feed ID" Min="1" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading || _bankFeedId is null or < 1"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               OnClick="GetBankFeedAsync">Get bank feed</MudButton>
                </MudStack>

                @if (_probe is not null && _bankFeed is not null)
                {
                    <ModelProbeResults Snapshot="_probe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All BankFeed model fields">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Result summary</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">ID: @_bankFeed.ResourceId</MudChip>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">@_bankFeed.FeedType</MudChip>
                            </MudStack>
                        </SummaryContent>
                        <HighlightContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">Bank account id</MudText>
                                        <MudText Typo="Typo.subtitle1">@(_bankFeed.BankAccountId?.ToString() ?? "Not returned")</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">Bank service</MudText>
                                        <MudText Typo="Typo.subtitle1">@ValueOrFallback(_bankFeed.BankServiceName)</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">State</MudText>
                                        <MudText Typo="Typo.subtitle1">@ValueOrFallback(_bankFeed.State)</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="probe-card" Elevation="0">
                                        <MudText Typo="Typo.caption">SCA expires at</MudText>
                                        <MudText Typo="Typo.subtitle1">@(_bankFeed.ScaExpiresAt?.ToString("u") ?? "Not returned")</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </HighlightContent>
                    </ModelProbeResults>
                }
                else if (!_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Run <strong>Get bank feed</strong> to load diagnostics.</MudText>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public long? BankFeedIdFromQuery { get; set; }

    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private long? _bankFeedId;
    private BankFeed? _bankFeed;
    private ModelProbeSnapshot? _probe;

    protected override void OnParametersSet()
    {
        if (BankFeedIdFromQuery is > 0)
        {
            _bankFeedId = BankFeedIdFromQuery;
        }
    }

    private void OnBankFeedIdChanged()
    {
        _bankFeed = null;
        _probe = null;
        _error = null;
    }

    private async Task GetBankFeedAsync()
    {
        if (_bankFeedId is null or < 1)
        {
            return;
        }

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;
        _bankFeed = null;
        _probe = null;

        var diagnosticsEndpoint = $"bank_feeds/{_bankFeedId}";

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _bankFeed = await client.BankFeeds.GetBankFeedAsync(
                _bankFeedId.Value,
                new BankFeedGetOptions { IncludeBankAccount = true });

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);

            _probe = ModelWireDiagnostics.Build(_bankFeed, _wireApiResponse, envelopeProperty: "bank_feed");
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "Not returned" : value;
}
