@page "/timeslips"
@using FreeAgent.Client.Models.Shared
@using FreeAgent.Client.Models.Timeslips
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Timeslips - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Timeslips endpoint"
                         Title="Timeslips list"
                         CallUnderTest="TimeslipService.ListAsync(...)"
                         Description="Load timeslips, inspect wire-to-model mapping for any row, then jump into Timeslip CRUD to test get, create, update, delete, and timers."
                         EndpointPath="/v2/timeslips?page={page}&amp;per_page={perPage}&amp;view={view}"
                         DocsUrl="https://dev.freeagent.com/docs/timeslips" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudGrid Spacing="2" Class="contacts-filter-grid">
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudSelect T="string"
                                       @bind-Value="_view"
                                       Label="View"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       FullWidth="true">
                                <MudSelectItem Value="@TimeslipViews.All">all</MudSelectItem>
                                <MudSelectItem Value="@TimeslipViews.Unbilled">unbilled</MudSelectItem>
                                <MudSelectItem Value="@TimeslipViews.Running">running</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudDatePicker @bind-Date="_fromDate"
                                           Label="From date"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           Class="w-100" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudDatePicker @bind-Date="_toDate"
                                           Label="To date"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           Class="w-100" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudDatePicker @bind-Date="_updatedSinceDate"
                                           Label="Updated since (date)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           Class="w-100" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudNumericField @bind-Value="_userIdFilter"
                                             Label="User ID filter"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudNumericField @bind-Value="_projectTaskIdFilter"
                                             Label="Task ID filter"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudNumericField @bind-Value="_projectIdFilter"
                                             Label="Project ID filter"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudSwitch @bind-Value="_nested" Color="Color.Primary" Label="nested=true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3" lg="2">
                            <MudNumericField @bind-Value="_perPage"
                                             Label="Per page"
                                             Min="1"
                                             Max="100"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="12" md="4" lg="3" Class="contacts-load-button-item">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudDownload"
                                       Disabled="_loading"
                                       Class="contacts-load-button"
                                       OnClick="LoadTimeslipsAsync">
                                @if (_loading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Loading…</span>
                                }
                                else
                                {
                                    <span>Load page 1</span>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudStack>

                @if (_pageResult is not null)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                            @_pageResult.Items.Count timeslip@(_pageResult.Items.Count == 1 ? string.Empty : "s") on page @_pageResult.Page
                        </MudChip>
                        @if (_pageResult.Total > 0)
                        {
                            <MudChip T="string" Variant="Variant.Outlined">Total: @_pageResult.Total</MudChip>
                        }
                    </MudStack>

                    @if (_pageResult.Items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No timeslips returned. Create a probe timeslip from
                            <MudLink Href="/timeslips/detail">Timeslip CRUD</MudLink>.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_timeslipRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Hours</MudTh>
                                    <MudTh>Task ID</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Date">@context.DatedOn</MudTd>
                                    <MudTd DataLabel="Hours">@context.Hours</MudTd>
                                    <MudTd DataLabel="Task ID">@ValueOrDash(context.ProjectTaskId)</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => InspectTimeslipAsync(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetCrudHref(context.Id)">
                                                Open in CRUD
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedTimeslip is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All Timeslip model fields (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected timeslip</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    ID: @_inspectedTimeslip.ResourceId
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                    </ModelProbeResults>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private PaginatedResponse<Timeslip>? _pageResult;
    private Timeslip? _inspectedTimeslip;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;
    private string? _view;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private DateTime? _updatedSinceDate;
    private long? _userIdFilter;
    private long? _projectTaskIdFilter;
    private long? _projectIdFilter;
    private bool _nested;
    private int _perPage = 25;

    private IReadOnlyList<TimeslipRow> _timeslipRows => _pageResult?.Items
        .Select(static (timeslip, index) => new TimeslipRow(
            index,
            timeslip.ResourceId,
            timeslip.DatedOn?.ToString("yyyy-MM-dd") ?? "-",
            timeslip.Hours?.ToString() ?? "-",
            timeslip.ProjectTaskId?.ToString()))
        .ToList() ?? [];

    private async System.Threading.Tasks.Task LoadTimeslipsAsync()
    {
        _pageResult = null;
        _inspectedTimeslip = null;
        _inspectedProbe = null;
        _inspectedIndex = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;

        var diagnosticsEndpoint = BuildDiagnosticsEndpoint();

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _pageResult = await client.Timeslips.ListAsync(
                page: 1,
                perPage: _perPage,
                view: _view,
                fromDate: _fromDate is null ? null : DateOnly.FromDateTime(_fromDate.Value),
                toDate: _toDate is null ? null : DateOnly.FromDateTime(_toDate.Value),
                updatedSince: _updatedSinceDate is null
                    ? null
                    : new DateTimeOffset(_updatedSinceDate.Value, TimeSpan.Zero),
                nested: _nested ? true : null,
                userId: _userIdFilter,
                projectTaskId: _projectTaskIdFilter,
                projectId: _projectIdFilter);

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectTimeslipAsync(int index)
    {
        if (_pageResult is null || index < 0 || index >= _pageResult.Items.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedTimeslip = _pageResult.Items[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "timeslips", index, out var wireTimeslip))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedTimeslip, wireTimeslip);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedTimeslip, _wireApiResponse, envelopeProperty: "timeslips");
    }

    private string BuildDiagnosticsEndpoint()
    {
        var query = new List<string>
        {
            "page=1",
            $"per_page={_perPage}"
        };

        if (!string.IsNullOrWhiteSpace(_view))
        {
            query.Add($"view={_view}");
        }

        if (_fromDate is not null)
        {
            query.Add($"from_date={_fromDate.Value:yyyy-MM-dd}");
        }

        if (_toDate is not null)
        {
            query.Add($"to_date={_toDate.Value:yyyy-MM-dd}");
        }

        if (_updatedSinceDate is not null)
        {
            query.Add($"updated_since={new DateTimeOffset(_updatedSinceDate.Value, TimeSpan.Zero):O}");
        }

        if (_nested)
        {
            query.Add("nested=true");
        }

        if (_userIdFilter is > 0)
        {
            query.Add($"user={Uri.EscapeDataString(UserReference.ForEnvironment(TokenStore.ConnectedEnvironment, _userIdFilter.Value).Uri)}");
        }

        if (_projectTaskIdFilter is > 0)
        {
            query.Add($"task={Uri.EscapeDataString(ProjectTaskReference.ForEnvironment(TokenStore.ConnectedEnvironment, _projectTaskIdFilter.Value).Uri)}");
        }

        if (_projectIdFilter is > 0)
        {
            query.Add($"project={Uri.EscapeDataString(ProjectReference.ForEnvironment(TokenStore.ConnectedEnvironment, _projectIdFilter.Value).Uri)}");
        }

        return $"timeslips?{string.Join('&', query)}";
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetCrudHref(long id) => $"/timeslips/detail?id={id}";

    private sealed record TimeslipRow(int Index, long Id, string DatedOn, string Hours, string? ProjectTaskId);
}
