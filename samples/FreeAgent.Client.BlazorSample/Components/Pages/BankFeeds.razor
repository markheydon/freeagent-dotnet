@page "/bank-feeds"
@using FreeAgent.Client.Models.BankFeeds
@using FreeAgent.Client.BlazorSample.Services
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Bank feeds - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Bank feeds endpoint"
                         Title="Bank feeds list"
                         CallUnderTest="BankFeedsService.ListAsync(...)"
                         Description="Load company bank feeds, inspect wire-to-model mapping for any row, then open bank feed detail for a single GET."
                         EndpointPath="/v2/bank_feeds"
                         DocsUrl="https://dev.freeagent.com/docs/bank_feeds" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Bank feeds are read-only and connect a bank service to a <MudLink Href="/bank-accounts">bank account</MudLink>.
                        Load the list, inspect mapping per row, then open detail for <code>GET /v2/bank_feeds/:id</code>.
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               Disabled="_loading"
                               OnClick="LoadBankFeedsAsync">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Loading…</span>
                        }
                        else
                        {
                            <span>Load bank feeds</span>
                        }
                    </MudButton>
                </MudStack>

                @if (_bankFeeds is null && !_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Press <strong>Load bank feeds</strong> to fetch records from FreeAgent.</MudText>
                }

                @if (_bankFeeds is not null)
                {
                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                        @_bankFeeds.Count bank feed@(_bankFeeds.Count == 1 ? "" : "s") loaded
                    </MudChip>

                    @if (_bankFeeds.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No bank feeds returned. Connect a bank feed in FreeAgent for one of your bank accounts.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Bank account</MudTh>
                                    <MudTh>Feed type</MudTh>
                                    <MudTh>Service</MudTh>
                                    <MudTh>State</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Bank account">@context.BankAccountId</MudTd>
                                    <MudTd DataLabel="Feed type">@context.FeedType</MudTd>
                                    <MudTd DataLabel="Service">@ValueOrDash(context.BankServiceName)</MudTd>
                                    <MudTd DataLabel="State">@ValueOrDash(context.State)</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => InspectRowAsync(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetDetailHref(context.Id)">
                                                Open detail
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedItem is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All BankFeed model fields (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected bank feed</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    ID: @_inspectedItem.ResourceId
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                    </ModelProbeResults>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private IReadOnlyList<BankFeed>? _bankFeeds;
    private BankFeed? _inspectedItem;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;

    private IReadOnlyList<BankFeedRow> _rows => _bankFeeds?
        .Select(static (item, index) => new BankFeedRow(
            index,
            item.ResourceId,
            item.BankAccountId?.ToString() ?? "-",
            item.FeedType?.ToString() ?? "-",
            item.BankServiceName,
            item.State))
        .ToList() ?? [];

    private async Task LoadBankFeedsAsync()
    {
        _bankFeeds = null;
        _inspectedItem = null;
        _inspectedProbe = null;
        _inspectedIndex = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;

        const string diagnosticsEndpoint = "bank_feeds";

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _bankFeeds = await client.BankFeeds.ListAsync();

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectRowAsync(int index)
    {
        if (_bankFeeds is null || index < 0 || index >= _bankFeeds.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedItem = _bankFeeds[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "bank_feeds", index, out var wireItem))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, wireItem);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, _wireApiResponse, envelopeProperty: "bank_feeds");
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetDetailHref(long id) => $"/bank-feeds/detail?id={id}";

    private sealed record BankFeedRow(int Index, long Id, string BankAccountId, string FeedType, string? BankServiceName, string? State);
}
