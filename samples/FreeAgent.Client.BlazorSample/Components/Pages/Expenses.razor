@page "/expenses"
@using FreeAgent.Client
@using FreeAgent.Client.Models.Expenses
@using FreeAgent.Client.Models.Shared
@using FreeAgent.Client.BlazorSample.Services
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Expenses - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Expenses endpoint"
                         Title="Expenses list"
                         CallUnderTest="ExpenseService.ListAsync(...) / ListAutoPagingAsync(...)"
                         Description="Load expenses, inspect wire-to-model mapping for any row, then open Expense CRUD to test create (category or mileage), batch create, update, delete, and mileage settings."
                         EndpointPath="/v2/expenses?page={page}&per_page={perPage}&view={view}"
                         DocsUrl="https://dev.freeagent.com/docs/expenses" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Connect to FreeAgent from the <MudLink Href="/">overview</MudLink> first.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudGrid Spacing="2" Class="contacts-filter-grid">
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSelect T="string"
                                   @bind-Value="_view"
                                   Label="View"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   FullWidth="true">
                            <MudSelectItem Value="@ExpenseViews.Recent">recent</MudSelectItem>
                            <MudSelectItem Value="@ExpenseViews.Recurring">recurring</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudNumericField @bind-Value="_projectIdFilter"
                                         Label="Project ID filter"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true"
                                         FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3" lg="2">
                        <MudNumericField @bind-Value="_perPage"
                                         Label="Per page"
                                         Min="1"
                                         Max="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true"
                                         FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="12" md="4" lg="3" Class="contacts-load-button-item">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudDownload"
                                   Disabled="_loading"
                                   OnClick="LoadExpensesAsync">
                            Load page 1
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @if (_pageResult is not null)
                {
                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                        @_pageResult.Items.Count expense@(_pageResult.Items.Count == 1 ? string.Empty : "s") on page @_pageResult.Page
                    </MudChip>

                    @if (_pageResult.Items.Count > 0)
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Description</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Date">@context.DatedOn</MudTd>
                                    <MudTd DataLabel="Description">@context.Description</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Filled"
                                                       Size="Size.Small"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       OnClick="@(() => InspectRow(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       Href="@($"/expenses/detail?id={context.Id}")">
                                                Open in CRUD
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedProbe is not null && _inspectedExpense is not null)
                {
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All Expense model fields (selected row)" />
                }

                <MudExpansionPanels>
                    <MudExpansionPanel Text="Developer probe: auto-pagination (ListAutoPagingAsync)">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2" Class="hero-copy">
                                Optional check that the async enumerator walks every page.
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.AllInclusive"
                                       Disabled="_loadingAll"
                                       OnClick="LoadAllAsync">
                                @if (_loadingAll)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Enumerating…</span>
                                }
                                else
                                {
                                    <span>Count all expenses</span>
                                }
                            </MudButton>

                            @if (_allExpensesCount is not null)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                                    <code>ListAutoPagingAsync</code> yielded @_allExpensesCount.Value expense@(_allExpensesCount.Value == 1 ? string.Empty : "s").
                                </MudAlert>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading;
    private bool _loadingAll;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private PaginatedResponse<Expense>? _pageResult;
    private Expense? _inspectedExpense;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;
    private int? _allExpensesCount;
    private string? _view;
    private long? _projectIdFilter;
    private int _perPage = 25;

    private IReadOnlyList<ExpenseRow> _rows => _pageResult?.Items
        .Select(static (expense, index) => new ExpenseRow(
            index,
            expense.ResourceId,
            expense.DatedOn?.ToString("yyyy-MM-dd") ?? "-",
            expense.Description ?? "-"))
        .ToList() ?? [];

    private async System.Threading.Tasks.Task LoadExpensesAsync()
    {
        _pageResult = null;
        _inspectedExpense = null;
        _inspectedProbe = null;
        _inspectedIndex = null;
        _allExpensesCount = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        var endpoint = BuildDiagnosticsEndpoint();

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _pageResult = await client.Expenses.ListAsync(
                page: 1,
                perPage: _perPage,
                view: _view,
                projectId: _projectIdFilter);

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                endpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectRow(int index)
    {
        if (_pageResult is null || index < 0 || index >= _pageResult.Items.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedExpense = _pageResult.Items[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "expenses", index, out var wireItem))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedExpense, wireItem);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedExpense, _wireApiResponse, envelopeProperty: "expenses");
    }

    private string BuildDiagnosticsEndpoint()
    {
        var query = new List<string> { "page=1", $"per_page={_perPage}" };
        if (!string.IsNullOrWhiteSpace(_view))
        {
            query.Add($"view={Uri.EscapeDataString(_view)}");
        }

        if (_projectIdFilter is > 0)
        {
            query.Add($"project={Uri.EscapeDataString(ProjectReference.ForEnvironment(TokenStore.ConnectedEnvironment, _projectIdFilter.Value).Uri)}");
        }

        return $"expenses?{string.Join('&', query)}";
    }

    private async System.Threading.Tasks.Task LoadAllAsync()
    {
        _allExpensesCount = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loadingAll = true;
        _error = null;

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            var count = 0;
            await foreach (var _ in client.Expenses.ListAutoPagingAsync(
                               perPage: _perPage,
                               view: _view,
                               projectId: _projectIdFilter))
            {
                count++;
            }

            _allExpensesCount = count;
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
        }
        finally
        {
            _loadingAll = false;
        }
    }

    private sealed record ExpenseRow(int Index, long Id, string DatedOn, string Description);
}
