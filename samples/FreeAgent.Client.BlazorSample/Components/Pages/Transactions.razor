@page "/transactions"
@using FreeAgent.Client.Models.Transactions
@using FreeAgent.Client.BlazorSample.Services
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Transactions - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Reports"
                         Title="Accounting transactions"
                         CallUnderTest="TransactionsService.ListAsync(...)"
                         Description="Load ledger transactions for an optional date range and nominal code, then inspect wire-to-model mapping per row."
                         EndpointPath="/v2/accounting/transactions"
                         DocsUrl="https://dev.freeagent.com/docs/transactions" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudText Typo="Typo.body2" Class="hero-copy">
                    Lists transactions posted to account categories. Leave the dates empty to use the current accounting period through today.
                    Requested periods must be 12 months or shorter, or fall inside a single accounting year.
                    Open <MudLink Href="/bank-transactions">bank transactions</MudLink> for statement lines.
                </MudText>

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Label="From date (optional)" @bind-Date="_fromDate" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Label="To date (optional)" @bind-Date="_toDate" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_nominalCode" Label="Nominal code (optional)" Clearable="true" />
                    </MudItem>
                </MudGrid>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudDownload"
                           Disabled="_loading"
                           OnClick="LoadTransactionsAsync">
                    Load transactions
                </MudButton>

                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }

                @if (_transactions is null && !_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Press <strong>Load transactions</strong> to fetch records from FreeAgent.</MudText>
                }

                @if (_transactions is not null)
                {
                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                        @_transactions.Count transaction@(_transactions.Count == 1 ? "" : "s") loaded
                    </MudChip>

                    @if (_transactions.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No transactions returned for these filters.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Dated on</MudTh>
                                    <MudTh>Description</MudTh>
                                    <MudTh>Nominal code</MudTh>
                                    <MudTh>Debit</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Dated on">@context.DatedOn</MudTd>
                                    <MudTd DataLabel="Description">@ValueOrDash(context.Description)</MudTd>
                                    <MudTd DataLabel="Nominal code">@ValueOrDash(context.NominalCode)</MudTd>
                                    <MudTd DataLabel="Debit">@context.DebitValue</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => InspectRow(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetDetailHref(context.Id)">
                                                Open detail
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedItem is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All AccountingTransaction model fields (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected transaction</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    ID: @_inspectedItem.ResourceId
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                    </ModelProbeResults>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private IReadOnlyList<AccountingTransaction>? _transactions;
    private AccountingTransaction? _inspectedItem;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string? _nominalCode;

    private IReadOnlyList<TransactionRow> _rows => _transactions?
        .Select(static (item, index) => new TransactionRow(
            index,
            item.ResourceId,
            item.DatedOn?.ToString("yyyy-MM-dd") ?? "-",
            item.Description,
            item.NominalCode,
            item.DebitValue?.ToString("0.00") ?? "-"))
        .ToList() ?? [];

    private async Task LoadTransactionsAsync()
    {
        _transactions = null;
        _inspectedItem = null;
        _inspectedProbe = null;
        _inspectedIndex = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;

        var from = _fromDate is null ? (DateOnly?)null : DateOnly.FromDateTime(_fromDate.Value);
        var to = _toDate is null ? (DateOnly?)null : DateOnly.FromDateTime(_toDate.Value);
        var nominalCode = string.IsNullOrWhiteSpace(_nominalCode) ? null : _nominalCode.Trim();
        var diagnosticsEndpoint = BuildDiagnosticsEndpoint(from, to, nominalCode);

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _transactions = await client.Transactions.ListAsync(from, to, nominalCode);

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectRow(int index)
    {
        if (_transactions is null || index < 0 || index >= _transactions.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedItem = _transactions[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "transactions", index, out var wireItem))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, wireItem);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, _wireApiResponse, envelopeProperty: "transactions");
    }

    private static string BuildDiagnosticsEndpoint(DateOnly? from, DateOnly? to, string? nominalCode)
    {
        var parts = new List<string>();
        if (from is not null)
        {
            parts.Add($"from_date={from.Value:yyyy-MM-dd}");
        }

        if (to is not null)
        {
            parts.Add($"to_date={to.Value:yyyy-MM-dd}");
        }

        if (!string.IsNullOrWhiteSpace(nominalCode))
        {
            parts.Add($"nominal_code={Uri.EscapeDataString(nominalCode)}");
        }

        return parts.Count == 0
            ? "accounting/transactions"
            : $"accounting/transactions?{string.Join("&", parts)}";
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetDetailHref(long id) => $"/transactions/detail?id={id}";

    private sealed record TransactionRow(int Index, long Id, string DatedOn, string? Description, string? NominalCode, string DebitValue);
}
