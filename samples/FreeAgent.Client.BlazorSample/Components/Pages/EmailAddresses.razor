@page "/email-addresses"
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Email Addresses - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Company endpoint"
                         Title="Verified sender email addresses"
                         CallUnderTest="EmailAddressesService.ListAsync()"
                         Description="Load verified sender addresses, then use Inspect mapping on any row to see wire-to-model diagnostics."
                         EndpointPath="/v2/email_addresses"
                         DocsUrl="https://dev.freeagent.com/docs/email_addresses" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Load verified sender email addresses, then use <strong>Inspect mapping</strong> on any row to compare the wire string with the SDK value.
                    </MudText>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Email"
                               Disabled="_loading"
                               OnClick="LoadEmailAddressesAsync">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Loading…</span>
                        }
                        else
                        {
                            <span>Load email addresses</span>
                        }
                    </MudButton>
                </MudStack>

                @if (_emailAddresses is null && !_loading && _error is null)
                {
                    <MudText Typo="Typo.body2" Class="hero-copy">Press <strong>Load email addresses</strong> to fetch addresses from FreeAgent.</MudText>
                }

                @if (_emailAddresses is not null)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                            @_emailAddresses.Count address@(_emailAddresses.Count == 1 ? string.Empty : "es") loaded
                        </MudChip>
                    </MudStack>

                    @if (_emailAddresses.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="hero-copy">No verified sender email addresses returned.</MudText>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_emailRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>#</MudTh>
                                    <MudTh>Address</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="#"><code>@context.Index</code></MudTd>
                                    <MudTd DataLabel="Address">@context.Value</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                   Size="Size.Small"
                                                   OnClick="@(() => InspectEmailAddressAsync(context.Index))">
                                            Inspect mapping
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedEmailAddress is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="String value (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected email address</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    Index: @_inspectedIndex
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                        <HighlightContent>
                            <MudPaper Class="probe-card" Elevation="0">
                                <MudText Typo="Typo.caption">Address</MudText>
                                <MudText Typo="Typo.subtitle1">@_inspectedEmailAddress</MudText>
                            </MudPaper>
                        </HighlightContent>
                    </ModelProbeResults>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private IReadOnlyList<string>? _emailAddresses;
    private string? _inspectedEmailAddress;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;

    private IReadOnlyList<StringRow> _emailRows => _emailAddresses?
        .Select(static (value, index) => new StringRow(index, value))
        .ToList() ?? [];

    private async Task LoadEmailAddressesAsync()
    {
        _emailAddresses = null;
        _inspectedEmailAddress = null;
        _inspectedProbe = null;
        _inspectedIndex = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;

        const string diagnosticsEndpoint = "email_addresses";

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _emailAddresses = await client.EmailAddresses.ListAsync();

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectEmailAddressAsync(int index)
    {
        if (_emailAddresses is null || index < 0 || index >= _emailAddresses.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedEmailAddress = _emailAddresses[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "email_addresses", index, out var wireItem))
        {
            _inspectedProbe = ModelWireDiagnostics.BuildStringArrayItem(_inspectedEmailAddress, wireItem);
        }
    }

    private sealed record StringRow(int Index, string Value);
}
