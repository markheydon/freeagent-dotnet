@page "/capital-assets"
@using FreeAgent.Client.BlazorSample.Services
@inject TokenStore TokenStore
@inject OAuthService OAuthService
@inject ApiDiagnosticsService ApiDiagnostics
@inject NavigationManager NavigationManager

<PageTitle>Capital assets - FreeAgent SDK Sample</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="sample-page">
    <EndpointProbeHeader SectionKicker="Capital assets endpoint"
                         Title="Capital assets list"
                         CallUnderTest="CapitalAssetsService.ListAsync(...)"
                         Description="Load capital assets, optionally filter by view or include lifecycle history, then inspect wire-to-model mapping per row."
                         EndpointPath="/v2/capital_assets?view={optional}&amp;include_history={optional}"
                         DocsUrl="https://dev.freeagent.com/docs/capital_assets" />

    @if (!TokenStore.IsConnected)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This probe needs an OAuth session first.
            <MudLink Href="/">Return to overview</MudLink> and connect to FreeAgent.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="workbench-panel" Elevation="0">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
                    <ApiErrorDiagnostics RawPayload="@_wireApiResponse" />
                }

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2" Class="hero-copy">
                        Capital assets are read-only and are usually created via expenses or bank explanations. Load the list, inspect mapping per row, then open detail for <code>GET /v2/capital_assets/:id</code>.
                    </MudText>

                    <MudSelect T="CapitalAssetView?" @bind-Value="_view" Label="View filter (optional)" Clearable="true" Dense="true">
                        <MudSelectItem T="CapitalAssetView?" Value="@((CapitalAssetView?)null)">API default</MudSelectItem>
                        <MudSelectItem T="CapitalAssetView?" Value="CapitalAssetView.All">all</MudSelectItem>
                        <MudSelectItem T="CapitalAssetView?" Value="CapitalAssetView.Disposed">disposed</MudSelectItem>
                        <MudSelectItem T="CapitalAssetView?" Value="CapitalAssetView.Disposable">disposable</MudSelectItem>
                    </MudSelect>

                    <MudCheckBox @bind-Value="_includeHistory" Label="include_history=true" Color="Color.Primary" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               Disabled="_loading"
                               OnClick="LoadCapitalAssetsAsync">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Loading…</span>
                        }
                        else
                        {
                            <span>Load capital assets</span>
                        }
                    </MudButton>
                </MudStack>

                @if (_items is not null)
                {
                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Success">
                        @_items.Count capital asset@(_items.Count == 1 ? "" : "s") loaded
                    </MudChip>

                    @if (_items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No capital assets returned. Create capital purchases via expenses or bank explanations in FreeAgent.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="diagnostics-table-shell">
                            <MudTable Items="@_rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="diagnostics-table">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>Description</MudTh>
                                    <MudTh>Asset type</MudTh>
                                    <MudTh>Purchased</MudTh>
                                    <MudTh>History</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID"><code>@context.Id</code></MudTd>
                                    <MudTd DataLabel="Description">@ValueOrDash(context.Description)</MudTd>
                                    <MudTd DataLabel="Asset type">@ValueOrDash(context.AssetType)</MudTd>
                                    <MudTd DataLabel="Purchased">@context.PurchasedOn</MudTd>
                                    <MudTd DataLabel="History">@context.HistoryCount</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(context.Index == _inspectedIndex ? Color.Primary : Color.Default)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => InspectRowAsync(context.Index))">
                                                Inspect mapping
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetDetailHref(context.Id)">
                                                Open detail
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                }

                @if (_inspectedItem is not null && _inspectedProbe is not null)
                {
                    <MudDivider />
                    <ModelProbeResults Snapshot="_inspectedProbe"
                                     WirePayload="@_wireApiResponse"
                                     ModelFieldsHeading="All CapitalAsset model fields (selected row)">
                        <SummaryContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h5">Inspected capital asset</MudText>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    ID: @_inspectedItem.ResourceId
                                </MudChip>
                            </MudStack>
                        </SummaryContent>
                    </ModelProbeResults>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading;
    private string? _error;
    private string _wireApiResponse = string.Empty;
    private CapitalAssetView? _view;
    private bool _includeHistory;
    private IReadOnlyList<CapitalAsset>? _items;
    private CapitalAsset? _inspectedItem;
    private ModelProbeSnapshot? _inspectedProbe;
    private int? _inspectedIndex;

    private IReadOnlyList<CapitalAssetRow> _rows => _items?
        .Select(static (item, index) => new CapitalAssetRow(
            index,
            item.ResourceId,
            item.Description,
            item.AssetType,
            item.PurchasedOn?.ToString() ?? "-",
            item.CapitalAssetHistory?.Count.ToString() ?? "-"))
        .ToList() ?? [];

    private async Task LoadCapitalAssetsAsync()
    {
        _items = null;
        _inspectedItem = null;
        _inspectedProbe = null;
        _inspectedIndex = null;

        var token = TokenStore.GetToken();
        if (token is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _loading = true;
        _error = null;
        _wireApiResponse = string.Empty;

        var diagnosticsEndpoint = BuildDiagnosticsEndpoint();

        try
        {
            using var client = OAuthService.CreateFreeAgentClient(token, TokenStore.ConnectedEnvironment);
            _items = await client.CapitalAssets.ListAsync(_view, _includeHistory);

            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (FreeAgentApiException ex)
        {
            _error = $"API error: {ex.Message}";
            _wireApiResponse = await ApiDiagnostics.FetchRawEndpointPayloadAsync(
                token.AccessToken,
                TokenStore.ConnectedEnvironment,
                diagnosticsEndpoint);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void InspectRowAsync(int index)
    {
        if (_items is null || index < 0 || index >= _items.Count)
        {
            return;
        }

        _inspectedIndex = index;
        _inspectedItem = _items[index];

        if (ModelWireDiagnostics.TryGetArrayItem(_wireApiResponse, "capital_assets", index, out var wireItem))
        {
            _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, wireItem);
            return;
        }

        _inspectedProbe = ModelWireDiagnostics.Build(_inspectedItem, _wireApiResponse, envelopeProperty: "capital_assets");
    }

    private string BuildDiagnosticsEndpoint()
    {
        var query = new List<string>();
        if (_view is CapitalAssetView view)
        {
            query.Add($"view={ViewWireValue(view)}");
        }

        if (_includeHistory)
        {
            query.Add("include_history=true");
        }

        return query.Count == 0 ? "capital_assets" : $"capital_assets?{string.Join('&', query)}";
    }

    private static string ViewWireValue(CapitalAssetView view) => view switch
    {
        CapitalAssetView.All => "all",
        CapitalAssetView.Disposed => "disposed",
        CapitalAssetView.Disposable => "disposable",
        _ => "all"
    };

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetDetailHref(long id) => $"/capital-assets/detail?id={id}";

    private sealed record CapitalAssetRow(
        int Index,
        long Id,
        string? Description,
        string? AssetType,
        string PurchasedOn,
        string HistoryCount);
}
