<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>freeagent-client-sample-v1</UserSecretsId>

    <!--
      SDK source toggle (see README):
        true  (default) — ProjectReference to src/FreeAgent.Client (repo development)
        false           — PackageReference to FreeAgent.Client on NuGet (consumer smoke test)

      dotnet run -p:UseLocalFreeAgentClient=false
    -->
    <UseLocalFreeAgentClient Condition="'$(UseLocalFreeAgentClient)' == ''">true</UseLocalFreeAgentClient>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalFreeAgentClient)' == 'true'">
    <ProjectReference Include="..\..\src\FreeAgent.Client\FreeAgent.Client.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFreeAgentClient)' != 'true'">
    <PackageReference Include="FreeAgent.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json" Condition="Exists('appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
