{
  "name": "FreeAgent.NET",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/markheydon/devcontainer-features/dev-agent-tools:1": {},
    "ghcr.io/stu-bell/devcontainer-features/cursor-cli:0": {}
  },
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_XMLDOC_MODE": "skip"
  },
  "onCreateCommand": "bash .devcontainer/setup-dotnet-dev-cert.sh && sudo apt-get update && sudo apt-get install -y libnss3-tools && dotnet restore FreeAgent.slnx",
  "remoteEnv": {
    "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust",
    "CURSOR_API_KEY": "${localEnv:CURSOR_API_KEY}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GH_HOST": "github.com"
  },
  "remoteUser": "vscode",
  "postStartCommand": "dotnet dev-certs https --trust",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "GitHub.vscode-github-actions"
      ]
    }
  }
}